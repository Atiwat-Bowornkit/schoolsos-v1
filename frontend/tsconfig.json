{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/App.vue",
    "src/main.ts",
    "src/router.ts",
    "src/school-sos/**/*.ts",
    "src/school-sos/**/*.vue",
    "vite.config.ts",
    "env.d.ts",
    "shims.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
