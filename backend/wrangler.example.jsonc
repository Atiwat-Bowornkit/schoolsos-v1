{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolsos-v1-backend",
  "main": "src/server.ts",
  "compatibility_date": "2026-07-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "school-sos-db",
      "database_id": "59d3c344-9277-4e22-aff4-96428e87d0f9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://schoolsos-v1.pages.dev"
  }
}
