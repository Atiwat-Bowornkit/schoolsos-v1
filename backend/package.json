{
  "name": "school-sos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.example.jsonc",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --config wrangler.example.jsonc --outdir dist/worker",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply school-sos-db --local --config wrangler.example.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply school-sos-db --remote",
    "db:seed:local": "wrangler d1 execute school-sos-db --local --config wrangler.example.jsonc --file seeds/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@scalar/hono-api-reference": "^0.11.9",
    "hono": "^4.8.0",
    "hono-openapi": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.23.0"
  }
}
